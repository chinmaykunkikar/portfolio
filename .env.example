# GitHub Personal Access Token
# Required for fetching GitHub contributions (including private contributions)
# Scopes needed: read:user
# Generate at: https://github.com/settings/tokens
GITHUB_READ_USER_TOKEN_PERSONAL=your_github_personal_access_token

# Spotify API credentials
# Required for displaying currently playing music
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# Mapbox API
# Required for map widget
# Get from: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
NEXT_PUBLIC_MAP_LONGITUDE=your_longitude
NEXT_PUBLIC_MAP_LATITUDE=your_latitude

# Statsy Analytics (Optional)
# For website analytics
NEXT_PUBLIC_STATSY_SITE_ID=your_statsy_site_id
NEXT_PUBLIC_STATSY_ENDPOINT=your_statsy_endpoint
